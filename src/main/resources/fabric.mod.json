{
	"schemaVersion": 1,
	"id": "burrow",
	"version": "${version}",
	"name": "Burrow",
	"description": "Your own friends list and world sharing — self-hosted.",
	"authors": [
		"meeyah"
	],
	"contact": {
		"homepage": "https://meeyah.dev"
	},
	"license": "MIT",
	"environment": "client",
	"accessWidener": "burrow.accesswidener",
	"entrypoints": {
		"client": [
			"dev.meeyah.burrow.BurrowClient"
		],
		"voicechat": [
			"dev.meeyah.burrow.compat.BurrowVoicechatPlugin"
		]
	},
	"mixins": [
		{
			"config": "burrow.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
